        <string>true</string>
        <key>WHISPER_NICE</key>
        <string>20</string>
        <key>WHISPER_THREADS</key>
        <string>2</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/ewilderj/Library/Logs/transcriber-local.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/ewilderj/Library/Logs/transcriber-local.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.transcriber.local</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/uv</string>
        <string>run</string>
        <string>/Users/ewilderj/git/meeting-notes-processor/transcriber/server/transcriber.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ewilderj/git/meeting-notes-processor/transcriber/server</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin</string>
        <key>WEBHOOK_URL</key>
        <string>http://127.0.0.1:9876/webhook</string>
        <key>TRANSCRIBER_HOST</key>
        <string>127.0.0.1</string>
        <key>TRANSCRIBER_PORT</key>
        <string>8000</string>
        <key>TRANSCRIBE_WHILE_RECORDING</key>
        <string>false</string>
        <key>TRANSCRIPTION_IDLE_DELAY_SECONDS</key>
        <string>30</string>
